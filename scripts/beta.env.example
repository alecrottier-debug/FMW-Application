# Copy this file to  scripts/beta.env  (that copy is git-ignored) and fill in your Issuer ID.
#
# Find it in App Store Connect → Users and Access → Integrations → App Store Connect API
# (the "Issuer ID" is the UUID shown at the top of that page).

ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# You normally do NOT need these two — beta.sh finds the .p8 in scripts/private/ and
# reads the Key ID from its filename (AuthKey_XXXX.p8 → XXXX). Uncomment only to override:
# ASC_KEY_ID=XXXXXXXXXX
# ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
